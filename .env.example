# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Optional: For Neo4j Aura
# NEO4J_URI=neo4j+s://xxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_aura_password

# BioPortal API Key (for ontology downloads)
# Get free key at: https://bioportal.bioontology.org/
BIOPORTAL_API_KEY=your_bioportal_api_key
